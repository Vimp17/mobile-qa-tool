<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>QA · {{ apk.label or apk.package }} {{ apk.version_name }} · {{ s.verdict_title }}</title>
<style>
:root{
  --bg:#f6f7f9; --panel:#ffffff; --ink:#15181e; --muted:#5d6573; --line:#e3e6eb; --soft:#f0f2f5;
  --pass:#1f8a4c; --pass-bg:#e7f5ec; --warn:#a96400; --warn-bg:#fdf3e1; --fail:#c62f2f; --fail-bg:#fde9e8;
  --info:#2f5fb3; --info-bg:#e9f0fc; --skip:#6b7280; --skip-bg:#eef0f3; --flaky:#7a4bc2; --flaky-bg:#f1eafc;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark){
  :root{ --bg:#0f1115; --panel:#171a20; --ink:#e7e9ee; --muted:#9aa3b2; --line:#2a2f38; --soft:#1e222a;
    --pass:#4cc27f; --pass-bg:#173123; --warn:#f0a83c; --warn-bg:#352812; --fail:#ff6b6b; --fail-bg:#3a1a1a;
    --info:#7aa5ff; --info-bg:#18243b; --skip:#9aa3b2; --skip-bg:#22262e; --flaky:#b993ff; --flaky-bg:#2a2140; }
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
.wrap{max-width:1180px;margin:0 auto;padding:24px 20px 60px}
header.top{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:flex-end;margin-bottom:18px}
.eyebrow{color:var(--muted);font-size:12px;letter-spacing:.06em;text-transform:uppercase}
h1{font-size:26px;margin:4px 0 0;font-weight:650;letter-spacing:-.01em}
h1 small{font-weight:400;color:var(--muted);font-size:18px}
.meta{color:var(--muted);font-size:13px;text-align:right}
.verdict{border-radius:14px;padding:20px 22px;margin-bottom:18px;border:1px solid var(--line);background:var(--panel);display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:start}
.verdict .badge{font-size:20px;font-weight:700;padding:10px 16px;border-radius:10px;white-space:nowrap}
.v-GO .badge{background:var(--pass-bg);color:var(--pass)}
.v-GO_WITH_REMARKS .badge{background:var(--warn-bg);color:var(--warn)}
.v-NO_GO .badge{background:var(--fail-bg);color:var(--fail)}
.v-GO{border-left:6px solid var(--pass)} .v-GO_WITH_REMARKS{border-left:6px solid var(--warn)} .v-NO_GO{border-left:6px solid var(--fail)}
.reasons{margin:0;padding:0;list-style:none}
.reasons li{padding:4px 0;display:flex;gap:8px;align-items:baseline}
.reasons .rid{font-family:var(--mono);font-size:12px;color:var(--muted);min-width:64px}
.dot{width:8px;height:8px;border-radius:50%;flex:none;transform:translateY(-1px)}
.dot.block{background:var(--fail)} .dot.remark{background:var(--warn)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:22px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.kpi .label{color:var(--muted);font-size:12px}
.kpi .value{font-size:22px;font-weight:650;margin-top:2px;font-variant-numeric:tabular-nums}
.kpi .sub{font-size:12px;color:var(--muted)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;margin-bottom:18px;overflow:hidden}
.panel > h2{font-size:16px;margin:0;padding:14px 16px 2px;font-weight:650;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.panel > .hint{color:var(--muted);font-size:12.5px;padding:0 16px 10px}
.chips{display:flex;gap:6px;font-weight:500}
.pill{display:inline-block;font-size:11.5px;font-weight:600;padding:2px 8px;border-radius:999px;white-space:nowrap}
.s-PASS{background:var(--pass-bg);color:var(--pass)} .s-WARN{background:var(--warn-bg);color:var(--warn)}
.s-FAIL{background:var(--fail-bg);color:var(--fail)} .s-INFO{background:var(--info-bg);color:var(--info)}
.s-SKIP{background:var(--skip-bg);color:var(--skip)} .s-FLAKY{background:var(--flaky-bg);color:var(--flaky)}
.s-BLOCKED{background:var(--fail-bg);color:var(--fail)}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:9px 16px;border-top:1px solid var(--line);vertical-align:top}
th{font-size:12px;color:var(--muted);font-weight:600;background:var(--soft)}
td.id{font-family:var(--mono);font-size:12px;color:var(--muted);white-space:nowrap;width:70px}
td.st{width:110px}
td.title{width:28%;font-weight:550}
td.num{font-variant-numeric:tabular-nums;white-space:nowrap}
details summary{cursor:pointer;color:var(--info);font-size:12.5px;margin-top:4px}
ul.items{margin:6px 0 0;padding-left:18px;font-family:var(--mono);font-size:12px;color:var(--muted);max-height:260px;overflow:auto}
.ev{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.ev img{height:120px;border-radius:6px;border:1px solid var(--line);cursor:zoom-in}
.ev a{font-size:12px}
dl.kv{display:grid;grid-template-columns:200px 1fr;margin:0;padding:6px 16px 14px}
dl.kv dt{color:var(--muted);padding:5px 0;border-top:1px solid var(--line)}
dl.kv dd{margin:0;padding:5px 0;border-top:1px solid var(--line);word-break:break-word}
.mono{font-family:var(--mono);font-size:12px}
.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px;padding:6px 16px 16px}
.gallery figure{margin:0}
.gallery img{width:100%;border-radius:8px;border:1px solid var(--line);cursor:zoom-in}
.gallery figcaption{font-size:12px;color:var(--muted);margin-top:4px}
pre{background:var(--soft);padding:12px;border-radius:8px;overflow:auto;font-size:12px;max-height:420px;margin:8px 0 0}
.crash{padding:10px 16px;border-top:1px solid var(--line)}
.crash .ct{font-weight:600}
.crash .mono{word-break:break-word}
td{overflow-wrap:anywhere}
.toolbar{display:flex;gap:8px;align-items:center;margin:0 0 12px;flex-wrap:wrap}
.toolbar label{display:flex;gap:6px;align-items:center;cursor:pointer;color:var(--muted);font-size:13px}
body.only-problems tr.ok{display:none}
.bar{height:8px;background:var(--info);border-radius:4px;min-width:2px}
tr.cur td{background:var(--soft)}
.files a{margin-right:14px}
#lightbox{position:fixed;inset:0;background:rgba(0,0,0,.8);display:none;align-items:center;justify-content:center;z-index:10;cursor:zoom-out}
#lightbox img{max-height:92vh;max-width:92vw;border-radius:8px}
footer{color:var(--muted);font-size:12px;margin-top:24px}
@media (max-width:720px){ .verdict{grid-template-columns:1fr} .reasons .rid{min-width:0} .reasons li{flex-wrap:wrap} dl.kv{grid-template-columns:1fr} td.title{width:auto} .meta{text-align:left} th:nth-child(1),td.id{display:none}}
@media print{ body{background:#fff} .toolbar{display:none} details{display:block} }
</style>
</head>
<body>
<div class="wrap">

<header class="top">
  <div>
    <div class="eyebrow">{{ s.project }} · {{ s.environment }} · {{ s.build_type }}-сборка</div>
    <h1>{{ apk.label or apk.package }} <small>{{ apk.version_name }} ({{ apk.version_code }})</small></h1>
  </div>
  <div class="meta">
    Прогон {{ s.timestamp[:19].replace('T', ' ') }} · {{ s.duration_sec }} с<br>
    <span class="mono">{{ s.run_id }}</span>
  </div>
</header>

<section class="verdict v-{{ s.verdict }}">
  <div class="badge">{{ s.verdict_title }}</div>
  <div>
    {% if s.reasons %}
    <ul class="reasons">
      {% for r in s.reasons[:10] %}
      <li><span class="dot {{ r.level }}"></span><span class="rid">{{ r.id }}</span><span><b>{{ r.title }}</b>{% if r.text %} — {{ r.text }}{% endif %}</span></li>
      {% endfor %}
      {% if s.reasons|length > 10 %}<li class="sub">…и ещё {{ s.reasons|length - 10 }}</li>{% endif %}
    </ul>
    {% else %}
    <p style="margin:6px 0">Все проверки пройдены. Сборку можно передавать в ручное тестирование.</p>
    {% endif %}
  </div>
</section>

{% set t = s.totals %}
<div class="kpis">
  <div class="kpi"><div class="label">Статический анализ</div>
    <div class="value">{{ t.static_fail }} / {{ t.static_warn }}</div><div class="sub">провалов / предупреждений из {{ t.static_total }}</div></div>
  <div class="kpi"><div class="label">Холодный старт</div>
    <div class="value">{% if s.metrics.cold_start_ms is defined %}{{ s.metrics.cold_start_ms }} мс{% else %}—{% endif %}</div>
    <div class="sub">{% if s.metrics.memory_pss_mb is defined %}память {{ s.metrics.memory_pss_mb }} МБ{% else %}медиана запусков{% endif %}</div></div>
  <div class="kpi"><div class="label">Сценарии</div>
    <div class="value">{% if t.tests_total %}{{ t.tests_passed }} / {{ t.tests_total }}{% else %}—{% endif %}</div>
    <div class="sub">{% if t.tests_total %}прошло{% if t.tests_flaky %}, нестабильных {{ t.tests_flaky }}{% endif %}{% else %}флоу не запускались{% endif %}</div></div>
  <div class="kpi"><div class="label">Крэши / ANR</div>
    <div class="value" {% if s.crashes %}style="color:var(--fail)"{% endif %}>{% if s.device %}{{ s.crashes|length }}{% else %}—{% endif %}</div>
    <div class="sub">{% if s.device %}по logcat за весь прогон{% else %}устройство не подключалось{% endif %}</div></div>
  <div class="kpi"><div class="label">Размер APK</div>
    <div class="value">{{ apk.size_mb }} МБ</div>
    <div class="sub">{% if s.prev_build %}было {{ s.prev_build.size_mb }} МБ в {{ s.prev_build.version_name }}{% else %}первая проверка пакета{% endif %}</div></div>
</div>

<div class="toolbar">
  <label><input type="checkbox" id="onlyProblems"> Показывать только проблемы</label>
</div>

<section class="panel">
  <h2>Сборка</h2>
  <dl class="kv">
    <dt>Пакет</dt><dd class="mono">{{ apk.package }}</dd>
    <dt>Версия</dt><dd>{{ apk.version_name }} (versionCode {{ apk.version_code }}){% if s.prev_build %} · прошлая проверенная: {{ s.prev_build.version_name }} ({{ s.prev_build.version_code }}){% endif %}</dd>
    <dt>SDK</dt><dd>minSdk {{ apk.min_sdk }} · targetSdk {{ apk.target_sdk }}{% if apk.compile_sdk %} · compileSdk {{ apk.compile_sdk }}{% endif %}</dd>
    <dt>Подпись</dt><dd>{{ apk.signing.schemes|join(', ') or 'нет' }}{% if apk.signing.certs %} · {{ apk.signing.certs[0].subject }} · до {{ apk.signing.certs[0].not_after }}{% endif %}</dd>
    <dt>Нативные ABI</dt><dd>{{ apk.native.abis|join(', ') or 'нет нативного кода' }}</dd>
    <dt>Разрешения</dt><dd>{{ apk.permissions|length }} (runtime: {{ apk.dangerous_permissions|length }})</dd>
    <dt>Локали</dt><dd>{{ apk.locales|length }}{% if apk.locales %}: {{ apk.locales[:20]|join(', ') }}{% if apk.locales|length > 20 %}…{% endif %}{% endif %}</dd>
    <dt>Файл</dt><dd>{{ apk.file_name }} · {{ apk.size_mb }} МБ</dd>
    <dt>SHA-256</dt><dd class="mono">{{ apk.sha256 }}</dd>
    {% if s.device %}<dt>Устройство</dt><dd>{{ s.device.title }} · <span class="mono">{{ s.device.serial }}</span> · ABI {{ s.device.abis|join(', ') }}{% if s.device.screen %} · {{ s.device.screen }}{% endif %}</dd>{% endif %}
  </dl>
</section>

{% for sec in sections %}
<section class="panel">
  <h2>{{ sec.title }}
    <span class="chips">{% for st, n in sec.counts.items() %}<span class="pill s-{{ st }}">{{ status_label[st] }}: {{ n }}</span>{% endfor %}</span>
  </h2>
  <div class="hint">{{ sec.hint }}</div>
  <table>
    <tr><th>ID</th><th>Статус</th><th>Проверка</th><th>Результат</th>{% if sec.key == 'maestro' %}<th>Время</th>{% endif %}</tr>
    {% for c in sec.rows %}
    <tr class="{{ 'ok' if c.status in ('PASS', 'SKIP', 'INFO') else 'problem' }}">
      <td class="id">{{ c.id }}</td>
      <td class="st"><span class="pill s-{{ c.status }}">{{ status_label[c.status] }}</span></td>
      <td class="title">{{ c.title }}{% if c.priority %} <span class="pill s-SKIP">{{ c.priority }}</span>{% endif %}</td>
      <td>
        {{ c.details }}
        {% if c['items'] %}
        <details {% if c['items']|length <= 3 and c.status in ('FAIL','WARN') %}open{% endif %}><summary>Подробности ({{ c['items']|length }})</summary>
          <ul class="items">{% for it in c['items'] %}<li>{{ it }}</li>{% endfor %}</ul>
        </details>
        {% endif %}
        {% if c.evidence %}
        <div class="ev">
          {% for e in c.evidence %}
            {% if e in images %}<img src="{{ images[e] }}" alt="{{ e }}" class="zoom">{% else %}<a href="{{ e }}">{{ e.split('/')[-1] }}</a>{% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </td>
      {% if sec.key == 'maestro' %}<td class="num">{{ c.duration_sec if c.duration_sec is not none else '' }} с</td>{% endif %}
    </tr>
    {% endfor %}
  </table>
</section>
{% endfor %}

{% if s.crashes %}
<section class="panel">
  <h2>Крэши и ANR <span class="pill s-FAIL">{{ s.crashes|length }}</span></h2>
  <div class="hint">Из logcat. Этап — когда случилось: install / launch / maestro / monkey. Стектрейс можно сразу прикладывать к багу.</div>
  {% for c in s.crashes %}
  <div class="crash">
    <div class="ct">{{ {'java':'Крэш', 'anr':'ANR', 'native':'Нативный крэш'}[c.kind] }} · этап «{{ c.stage }}» · {{ c.time }}</div>
    <div class="mono">{{ c.title }}</div>
    <details><summary>Стектрейс</summary><pre>{{ c.text }}</pre></details>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if gallery %}
<section class="panel">
  <h2>Скриншоты</h2>
  <div class="gallery">
    {% for g in gallery %}
    <figure><img src="{{ g.src }}" alt="{{ g.caption }}" class="zoom"><figcaption><span class="pill s-{{ g.status }}">{{ status_label[g.status] }}</span> {{ g.caption }}</figcaption></figure>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if history|length > 1 %}
<section class="panel">
  <h2>История проверок пакета</h2>
  <div class="hint">Последние {{ history|length }} прогонов. Тренд холодного старта — полоска.</div>
  <table>
    <tr><th>Дата</th><th>Версия</th><th>Вердикт</th><th>Статика (F/W)</th><th>Тесты</th><th>Крэши</th><th colspan="2">Холодный старт</th></tr>
    {% for h in history|reverse %}
    <tr class="{{ 'cur' if h.run_id == s.run_id else '' }}">
      <td class="num">{{ h.date }}</td>
      <td>{{ h.version_name }} ({{ h.version_code }})</td>
      <td><span class="pill s-{{ {'GO':'PASS','GO_WITH_REMARKS':'WARN','NO_GO':'FAIL'}.get(h._verdict, 'SKIP') }}">{{ h.verdict }}</span></td>
      <td class="num">{{ h.static_fail }} / {{ h.static_warn }}</td>
      <td class="num">{% if h.tests_total %}{{ h.tests_passed }}/{{ h.tests_total }}{% else %}—{% endif %}</td>
      <td class="num">{{ h.crashes }}</td>
      <td class="num">{{ h.cold_start_ms ~ ' мс' if h.cold_start_ms != '' else '—' }}</td>
      <td style="width:160px">{% if h.cold_start_ms != '' and max_cs %}<div class="bar" style="width:{{ (h.cold_start_ms / max_cs * 100)|round(0) }}%"></div>{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
</section>
{% endif %}

<section class="panel">
  <h2>Файлы прогона</h2>
  <div class="hint files">
    <a href="summary.json">summary.json</a>
    {% if s.logcat_file %}<a href="{{ s.logcat_file }}">logcat.txt</a>{% endif %}
    {% if s.has_junit %}<a href="maestro/junit.xml">junit.xml</a>{% endif %}
    <a href="junit_all.xml">junit_all.xml (для CI)</a>
    <br>Папка: <span class="mono">{{ s.run_dir }}</span>
  </div>
</section>

<footer>Сформировано qa-tool {{ s.tool_version }}. Автоматическая проверка не заменяет исследовательское тестирование. Она убирает рутину перед ним.</footer>
</div>

<div id="lightbox"><img alt=""></div>
<script>
(function(){
  var cb = document.getElementById('onlyProblems');
  try { cb.checked = localStorage.getItem('qa-only-problems') === '1'; } catch(e) {}
  function apply(){ document.body.classList.toggle('only-problems', cb.checked); try{localStorage.setItem('qa-only-problems', cb.checked?'1':'0')}catch(e){} }
  cb.addEventListener('change', apply); apply();
  var lb = document.getElementById('lightbox'), li = lb.querySelector('img');
  document.querySelectorAll('img.zoom').forEach(function(img){
    img.addEventListener('click', function(){ li.src = img.src; lb.style.display = 'flex'; });
  });
  lb.addEventListener('click', function(){ lb.style.display = 'none'; });
})();
</script>
</body>
</html>
